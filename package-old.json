{
  "name": "lessons-manager",
  "version": "1.0.0",
  "description": "Lessons manager with audio transcription and summaries",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && vite",
    "dev:backend": "cd backend && python run_dev.py",
    "dev:backend-fast": "cd backend && python run_no_reload.py",
    "build:frontend": "cd frontend && vite build",
    "build": "npm run build:frontend",
    "preview": "cd frontend && vite preview"
  },
  "dependencies": {
    "@clerk/vue": "^1.17.12",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "axios": "^1.6.2",
    "marked": "^11.2.0",
    "vue": "^3.3.10",
    "vue-i18n": "^9.8.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^7.2.7"
  },
  "build": {}
}
